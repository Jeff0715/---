        /* --- 怪獸 CSS 核心 (V5 精修版) --- */
        /* 🟠 橘寶 (Spark) */
        .m-orange { width: 90px; height: 90px; background: radial-gradient(circle at 30% 30%, #ff8c00, #e65100); border-radius: 50% 50% 50% 0; transform: rotate(-45deg); box-shadow: 0 10px 20px rgba(230, 81, 0, 0.4); position: relative; overflow: hidden; }
        .m-orange::after { content: ''; position: absolute; top: 18px; left: 8px; width: 65px; height: 22px; background: #333; border-radius: 12px; transform: rotate(45deg); border: 2px solid #555; z-index: 2; }
        .mo-eyes { position: absolute; top: 32px; left: 32px; display: flex; gap: 6px; transform: rotate(45deg); z-index: 1; }
        .mo-eye { width: 12px; height: 12px; background: #ffffff; border-radius: 50%; box-shadow: 0 0 5px rgba(255,255,255,0.6); }
        .mo-mole { position: absolute; bottom: 20px; right: 20px; width: 4px; height: 4px; background: #331a00; border-radius: 50%; z-index: 3; opacity: 0.8; }

        /* 🔵 布魯 (Logic) */
        .m-blue { width: 90px; height: 90px; background: linear-gradient(135deg, #1e5bbd 0%, #06377B 100%); border-radius: 18px; box-shadow: 0 0 25px rgba(6, 55, 123, 0.4); position: relative; overflow: hidden; }
        .m-blue::after { content: ''; position: absolute; top: 32px; left: 12px; width: 60px; height: 20px; background: #000000; border: 2px solid #3b82f6; border-radius: 6px; z-index: 2; }
        .mb-eyes { position: absolute; top: 36px; left: 22px; display: flex; gap: 18px; z-index: 3; }
        .mb-eye { width: 8px; height: 8px; background: #ffffff; border-radius: 50%; box-shadow: 0 0 4px rgba(255,255,255,0.8); }
        .mb-pattern { position: absolute; bottom: -10px; right: -10px; width: 45px; height: 45px; background: linear-gradient(135deg, rgba(255,255,255,0.2), rgba(6, 55, 123, 0.5)); transform: rotate(15deg); border-radius: 6px; }

        /* 🟢 綠豆 (Eco) */
        .m-green { width: 80px; height: 100px; background: linear-gradient(to right, #56ab2f, #a8e063); border-radius: 40% 40% 40% 40% / 60% 60% 30% 30%; box-shadow: 0 0 25px rgba(86, 171, 47, 0.5); position: relative; }
        .mg-soil { position: absolute; top: 0px; left: 30px; width: 18px; height: 5px; background: #2e5c1b; border-radius: 50%; opacity: 0.6; }
        .mg-stem { position: absolute; top: -12px; left: 37px; width: 4px; height: 18px; background: #8BC34A; border-radius: 4px; }
        .mg-leaf-l { position: absolute; top: -16px; left: 28px; width: 10px; height: 10px; background: #8BC34A; border-radius: 100% 0 100% 0; transform: rotate(-10deg); }
        .mg-leaf-r { position: absolute; top: -20px; left: 39px; width: 12px; height: 12px; background: #76b041; border-radius: 0 100% 0 100%; transform: rotate(-20deg); }
        .mg-eyes { position: absolute; top: 32px; left: 25px; display: flex; gap: 12px; }
        .mg-eye { width: 9px; height: 9px; background: linear-gradient(to bottom, #ffffff, #e2e8f0); border-radius: 50%; }

        /* ⚪️ 小白 (Uni) */
        .m-white { width: 110px; height: 80px; background: radial-gradient(circle at 30% 30%, #ffffff, #f1f5f9); border: none; border-radius: 50% 50% 40% 40% / 60% 60% 35% 35%; box-shadow: 0 0 25px rgba(200, 200, 220, 0.8), inset 0 -5px 15px rgba(0,0,0,0.05); position: relative; }
