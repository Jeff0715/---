            0% { transform: scale(1); }
            10%, 20% { transform: scale(0.95) rotate(-4deg); }
            30%, 50%, 70%, 90% { transform: scale(1.05) rotate(4deg); }
            40%, 60%, 80% { transform: scale(1.05) rotate(-4deg); }
            100% { transform: scale(1); }
