                    roleName: "🤝 整合大師", ipName: "小白 Uni", color: "#475569", bg: "#f8fafc", 
                    monster: '<div class="m-white"><div class="m-white-face"><div class="mw-eye"></div><div class="mw-eye"></div></div></div>',
                    traitsP1: "你具備極強的同理心與大局觀，不僅關注眼前的利益，更在乎長遠的共好價值。你擅長跨界溝通與資源整合，能輕易卸下他人的防備，將不同背景與專業的人緊緊凝聚在一起。",
                    traitsP2: "💡 職場超能力：你是團隊中最不可或缺的潤滑劑與生態系推手。你不需要打敗對手，因為你有本事把對手都變成盟友，創造出 1+1 大於 3 的驚人綜效。",
                    celebName: "黃仁勳 (Jensen Huang)",
                    celebDesc: "掀起全球 AI 狂潮的生態系推手！以極強的親和力與「共好」精神，串聯上下游無數合作夥伴，貫徹「大家一起贏」的整合哲學。",
                    story: "你走過的每條路徑，都開滿了友誼與信任的花朵。當其他精靈領袖都在為了爭奪領地與資源而互相提防、甚至開戰時，你卻背著行囊，穿梭在各個敵對的陣營之間。<br><br>你用真誠的傾聽與驚人的談判手腕，化解了長達百年的族群仇恨，成功串聯起各具專長的部落。最終，你並沒有建立單一的王國，而是打造了一個包容所有族群的「森靈大聯盟」。創源之樹為你的偉大願景降下祝福，你創造的不是一個國度，而是一個永遠和平、共生共榮的黃金時代！",
                    tags: ["#跨界聯盟", "#和諧共贏", "#資源整合"],
                    collab: [
                        { icon: 'D', t: "與「行動派勇士(橘寶)」合作", c: "幫勇士那些超前時代的發明尋找「接地氣」的試用場景。你的廣大人脈能讓他的新技術迅速被大眾接受並找到買家。" },
                        { icon: 'B', t: "與「營運智囊(綠豆)」合作", c: "在帶回大量新夥伴與新資源前，你需要推手的嚴謹規劃，確保聚落的基礎建設能夠承載這麼龐大的生態系擴張。" }
                    ]
                }
            };

            const res = dataMap[type];
            document.getElementById('result-role').innerText = res.roleName;
            document.getElementById('result-name').innerText = res.ipName;
            
            document.getElementById('result-name').style.color = res.color;
            document.getElementById('result-theme-bg').style.backgroundColor = res.bg;
            document.getElementById('celeb-icon-bg').style.backgroundColor = res.color;
            
            document.getElementById('result-monster-icon').innerHTML = `<div class="result-monster-active">${res.monster}</div>`;
            
            document.getElementById('trait-title').style.borderColor = res.color;
            document.getElementById('celeb-title').style.borderColor = res.color;
            document.getElementById('story-title').style.borderColor = res.color;

            document.getElementById('result-traits-p1').innerText = res.traitsP1;
            document.getElementById('result-traits-p2').innerText = res.traitsP2;
            document.getElementById('result-traits-p2').style.color = res.color;
            
            document.getElementById('result-celeb-name').innerText = res.celebName;
            document.getElementById('result-celeb-name').style.color = res.color;
            document.getElementById('result-celeb-desc').innerText = res.celebDesc;
            
            document.getElementById('result-story').innerHTML = res.story;
            
            document.getElementById('result-tags').innerHTML = res.tags.map(t => `<span class="bg-white px-3 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm font-bold border shadow-sm" style="color:${res.color}; border-color:${res.color}40">${t}</span>`).join('');
            
            document.getElementById('result-collab').innerHTML = res.collab.map(item => `
                <div class="bg-white p-4 sm:p-5 rounded-2xl border-l-[6px] shadow-sm hover:shadow-md transition flex flex-col gap-2" style="border-color:${res.color}">
                    <div class="flex items-center gap-3">
                        ${miniAvatars[item.icon]}
                        <div class="font-black text-sm sm:text-base" style="color:${res.color}">${item.t}</div>
                    </div>
                    <div class="text-slate-600 text-xs sm:text-sm leading-relaxed mt-1">${item.c}</div>
                </div>
            `).join('');

            if(radarChartInstance) radarChartInstance.destroy();
            const ctx = document.getElementById('radarChart').getContext('2d');
            
            const gradient = ctx.createRadialGradient(180, 180, 0, 180, 180, 180);
            gradient.addColorStop(0, res.color + '66');
            gradient.addColorStop(1, res.color + '11');

            const dynamicLabels = [
                `創新性 (${dim.innov})`,
                `先動性 (${dim.proac})`,
                `風險承擔 (${dim.risk})`,
                `自主性 (${dim.auto})`,
                `競爭積極 (${dim.comp})`
            ];

            radarChartInstance = new Chart(ctx, {
                type: 'radar',
                data: {
                    labels: dynamicLabels,
                    datasets: [{
                        data: [dim.innov, dim.proac, dim.risk, dim.auto, dim.comp],
                        backgroundColor: gradient, 
                        borderColor: res.color, 
                        borderWidth: 3,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: res.color,
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        fill: true
                    }]
                },
                options: {
                    layout: { padding: { top: 25, bottom: 25, left: 25, right: 25 } },
                    scales: { 
                        r: { 
                            min: 0, max: 10,
                            ticks: { display: false, stepSize: 2 },
                            grid: { color: 'rgba(0,0,0,0.08)', circular: true, lineWidth: 1.5 },
                            angleLines: { color: 'rgba(0,0,0,0.08)', lineWidth: 1.5 },
                            pointLabels: { 
                                font: { family: 'Noto Sans TC', size: window.innerWidth < 640 ? 11 : 13, weight: 'bold' }, 
                                color: '#475569', 
                                padding: 15
                            }
                        } 
                    },
                    plugins: { legend: { display: false } },
                    maintainAspectRatio: false,
                    animation: { duration: 1500, easing: 'easeOutQuart' }
                }
            });
        }

        function downloadResult() {
            const area = document.getElementById('result-capture-area');
            const btn = document.querySelector('button[onclick="downloadResult()"]');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 圖片生成中...';
            btn.disabled = true;

            setTimeout(() => {
                html2canvas(area, { 
                    scale: window.innerWidth < 640 ? 1.5 : 2,
                    useCORS: true,
                    backgroundColor: '#f0fdf4',
                    windowWidth: 1200 
                }).then(canvas => {
                    const link = document.createElement('a');
                    link.download = '森靈谷創業結果報告.png';
                    link.href = canvas.toDataURL('image/png');
                    link.click();
                    
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }).catch(err => {
                    console.error("截圖失敗:", err);
                    alert("圖片生成失敗，請稍後再試！");
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                });
            }, 500);
        }
    </script>
</body>
</html>
