        function calculateResult() {
            let scores = { A: 0, B: 0, C: 0, D: 0 };
            let dim = { innov: 5, proac: 5, risk: 5, auto: 5, comp: 5 };

            currentAnswers.forEach(ans => {
                scores[ans]++;
                if(ans === 'A') { dim.comp += 1; dim.risk -= 0.5; dim.auto -= 0.5; dim.proac += 0.5; }
                if(ans === 'B') { dim.auto += 1.5; dim.innov -= 0.5; dim.comp += 0.5; }
                if(ans === 'C') { dim.proac += 1; dim.comp -= 0.5; dim.risk -= 0.5; dim.innov += 0.5; }
                if(ans === 'D') { dim.innov += 1.5; dim.risk += 1; dim.auto -= 0.5; }
            });

            for(let key in dim) {
                dim[key] = Math.round(Math.min(Math.max(dim[key], 5), 10)); // 保底 5 分
            }

            const sortedKeys = Object.keys(scores).sort((a, b) => {
                if(scores[b] !== scores[a]) return scores[b] - scores[a];
                const checkIndices = [0, 7, 1];
                for(let idx of checkIndices) {
                    if(record[idx] === a) return -1;
                    if(record[idx] === b) return 1;
                }
                return 0;
            });
